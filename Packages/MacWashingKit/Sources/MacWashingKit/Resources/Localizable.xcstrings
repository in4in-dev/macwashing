    "Путь защищён от удаления" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Dieser Pfad ist vor dem Entfernen geschützt" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This path is protected from removal" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta ruta está protegida contra la eliminación" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ce chemin est protégé contre la suppression" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo percorso è protetto dalla rimozione" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "このパスは削除から保護されています" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 경로는 삭제로부터 보호됩니다" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Ta ścieżka jest chroniona przed usunięciem" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Este caminho está protegido contra remoção" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu yol kaldırılmaya karşı korunuyor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此路径受保护，无法移除" } } } },
    "Нужен помощник для системных папок" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Hilfsprogramm für Systemordner ist erforderlich" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "The system folders helper is required" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se necesita el asistente para carpetas del sistema" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’assistant pour les dossiers système est requis" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "È necessario l’assistente per le cartelle di sistema" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "システムフォルダ用のヘルパーが必要です" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템 폴더용 도우미가 필요합니다" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Wymagany jest pomocnik do folderów systemowych" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "É necessário o auxiliar para pastas do sistema" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sistem klasörleri için yardımcı gerekli" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要系统文件夹辅助程序" } } } },
    "Не удалось отозвать доступ. Измените его в Системных настройках" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Zugriff konnte nicht entzogen werden. Ändere ihn in den Systemeinstellungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t revoke access. Change it in System Settings" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo retirar el acceso. Cámbialo en Ajustes del Sistema" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de retirer l’accès. Modifiez-le dans Réglages Système" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Impossibile revocare l’accesso. Modificalo in Impostazioni di Sistema" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アクセスを取り消せませんでした。システム設定で変更してください" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "접근 권한을 해제하지 못했습니다. 시스템 설정에서 변경하세요" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "Nie udało się odebrać dostępu. Zmień go w Ustawieniach systemowych" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não foi possível revogar o acesso. Altere-o nos Ajustes do Sistema" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Erişim kaldırılamadı. Sistem Ayarları’nda değiştirin" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法撤销访问权限。请在系统设置中更改" } } } },
    "Это разрешение можно изменить только в Системных настройках" : { "localizations" : { "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese Berechtigung kann nur in den Systemeinstellungen geändert werden" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "This permission can be changed only in System Settings" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Este permiso solo se puede cambiar en Ajustes del Sistema" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette autorisation ne peut être modifiée que dans Réglages Système" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Questo permesso si può modificare solo in Impostazioni di Sistema" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "この許可はシステム設定でのみ変更できます" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이 권한은 시스템 설정에서만 변경할 수 있습니다" } }, "pl" : { "stringUnit" : { "state" : "translated", "value" : "To uprawnienie można zmienić tylko w Ustawieniach systemowych" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Esta permissão só pode ser alterada nos Ajustes do Sistema" } }, "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu izin yalnızca Sistem Ayarları’nda değiştirilebilir" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此权限只能在系统设置中更改" } } } },
