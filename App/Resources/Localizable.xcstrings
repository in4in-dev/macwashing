    "Объекты с пометкой «Осторожно» и файлы открытых программ автоочистка не трогает." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte mit der Markierung „Vorsicht“ und Dateien geöffneter Apps rührt die automatische Reinigung nicht an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-Clean never touches items marked “Caution” or files of open apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La limpieza automática no toca los elementos marcados «Precaución» ni los archivos de apps abiertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nettoyage auto ne touche ni aux éléments marqués « Attention » ni aux fichiers des apps ouvertes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pulizia automatica non tocca gli elementi segnati «Attenzione» né i file delle app aperte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「注意」の付いた項目と、開いているアプリのファイルには自動クリーンは触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 정리는 ‘주의’ 표시 항목과 열려 있는 앱의 파일은 건드리지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoczyszczenie nie rusza obiektów oznaczonych „Uwaga” ani plików otwartych aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A limpeza automática não mexe em itens marcados “Cuidado” nem em arquivos de apps abertos."
          }
        },
        "tr" : {
          "stringUnit" : {
