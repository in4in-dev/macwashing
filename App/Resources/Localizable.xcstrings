        }
      }
    },
    "%@ сразу потеряет доступ и сможет запросить его снова позже." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verliert den Zugriff sofort und kann ihn später erneut anfordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ loses access right away and may ask for it again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perderá el acceso de inmediato y podrá volver a solicitarlo más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perd l’accès immédiatement et pourra le redemander plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perde subito l’accesso e potrà richiederlo di nuovo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はすぐにアクセスできなくなり、あとで再度許可を求める場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 즉시 접근 권한을 잃으며 나중에 다시 요청할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ od razu straci dostęp i może poprosić o niego ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ perde o acesso imediatamente e poderá solicitá-lo novamente mais tarde."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erişimi hemen kaybeder ve daha sonra yeniden isteyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将立即失去访问权限，之后可能会再次请求。"
          }
        }
      }
    },
    "Программа потеряет доступ ко всем программам, которыми управляет." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App verliert den Zugriff auf alle Apps, die sie steuert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It loses access to every app it controls."
