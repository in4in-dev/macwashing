    "Файл остаётся на месте — включить обратно можно здесь же." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei bleibt erhalten – Sie können es hier wieder einschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file stays where it is, so you can turn it back on right here."
          }
        },
        "es" : {
          "stringUnit" : {
