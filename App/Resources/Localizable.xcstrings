            "value" : "Potrzebny pomocnik"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistente necessário"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
