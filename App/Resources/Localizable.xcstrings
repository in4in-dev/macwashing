          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja %@ jest uruchomiona — przed usunięciem zostanie zamknięta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em execução — o app será encerrado antes da remoção."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ çalışıyor. Kaldırmadan önce kapatılacak."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在运行，移除前将退出该 App。"
          }
        }
      }
    },
    "%@ — %@ будет перемещено в Корзину. Пока Корзина не очищена, всё можно вернуть." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ werden in den Papierkorb gelegt. Bis du den Papierkorb entleerst, lässt sich alles wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ will be moved to the Trash. You can put everything back until you empty the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ se trasladarán a la Papelera. Podrás recuperarlo todo hasta que vacíes la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ seront placés dans la Corbeille. Tout peut être récupéré tant que la Corbeille n’est pas vidée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ verranno spostati nel Cestino. Potrai recuperare tutto finché non svuoti il Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@をゴミ箱に移動します。ゴミ箱を空にするまでは、すべて元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@이(가) 휴지통으로 이동됩니다. 휴지통을 비우기 전까지는 모두 되돌릴 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ zostanie przeniesione do Kosza. Dopóki nie opróżnisz Kosza, możesz wszystko przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ serão movidos para o Lixo. Você pode recuperar tudo até esvaziar o Lixo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ Çöp Sepeti’ne taşınacak. Çöp Sepeti’ni boşaltana kadar her şeyi geri koyabilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — %@ 将被移到废纸篓。在清倒废纸篓之前，你可以恢复所有内容。"
          }
        }
      }
    },
