        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「終了して再度開く」には「後で」と答えてかまいません。MacWashing はそのままでもアクセスを認識します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘종료 후 다시 열기’에는 ‘나중에’를 선택해도 됩니다. MacWashing은 그대로 접근 권한을 인식합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na „Zakończ i otwórz ponownie” możesz odpowiedzieć „Później”: MacWashing i tak zobaczy dostęp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em “Encerrar e Reabrir”, você pode responder “Mais Tarde”: o MacWashing reconhece o acesso mesmo assim."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Çık ve Yeniden Aç” sorusuna “Daha Sonra” diyebilirsiniz: MacWashing erişimi yine de görür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于“退出并重新打开”，可以选择“稍后”：MacWashing 照样能获得访问权限。"
          }
        }
      }
    },
