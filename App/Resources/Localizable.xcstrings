    "%@ может работать хуже без него." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funktioniert ohne ihn möglicherweise schlechter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ may not work as well without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que %@ funcione peor sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ risque de moins bien fonctionner sans lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ potrebbe funzionare peggio senza di esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これがないと%@が正しく動作しないことがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목이 없으면 %@이(가) 제대로 작동하지 않을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
