    "Программы, закрытые кнопкой, откроются снова, когда очистка закончится." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per Taste beendete Apps werden nach der Bereinigung wieder geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps quit with the button open again when cleaning is done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps cerradas con el botón se volverán a abrir al terminar la limpieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps quittées avec ce bouton se rouvriront une fois le nettoyage terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app chiuse con il pulsante si riapriranno al termine della pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボタンで終了したアプリは、クリーンアップ完了後に再び開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "버튼으로 종료한 앱은 정리가 끝나면 다시 열립니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje zamknięte przyciskiem otworzą się ponownie po zakończeniu czyszczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps encerrados pelo botão serão abertos de novo quando a limpeza terminar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düğmeyle kapatılan uygulamalar temizlik bitince yeniden açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用按钮退出的 App 会在清理完成后重新打开。"
          }
        }
      }
    },
    "Промежуточные файлы сборки, данные для отладки старых версий iOS и симуляторы, которые Xcode больше не использует." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischendateien von Builds, Debugging-Daten für alte iOS-Versionen und Simulatoren, die Xcode nicht mehr verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intermediate build files, debugging data for old iOS versions, and simulators that Xcode no longer uses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos intermedios de compilación, datos de depuración para versiones antiguas de iOS y simuladores que Xcode ya no usa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers de compilation intermédiaires, données de débogage pour d’anciennes versions d’iOS et simulateurs qu’Xcode n’utilise plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File intermedi di build, dati di debug per vecchie versioni di iOS e simulatori che Xcode non usa più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中間ビルドファイル、古いiOSバージョンのデバッグデータ、Xcodeで使われなくなったシミュレータ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중간 빌드 파일, 이전 iOS 버전용 디버깅 데이터, Xcode에서 더 이상 사용하지 않는 시뮬레이터."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pośrednie pliki kompilacji, dane debugowania dla starych wersji iOS i symulatory, których Xcode już nie używa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos intermediários de build, dados de depuração de versões antigas do iOS e simuladores que o Xcode não usa mais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
