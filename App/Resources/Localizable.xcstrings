    "Место (%@) освободится, когда вы очистите Корзину." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherplatz (%@) wird frei, wenn du den Papierkorb entleerst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The space (%@) will be freed when you empty the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El espacio (%@) se liberará cuando vacíes la Papelera."
          }
        },
