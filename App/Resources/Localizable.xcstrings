    "%@ сейчас работает в фоне — перед удалением служба будет остановлена." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ läuft gerade im Hintergrund. Der Dienst wird vor dem Entfernen beendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is running in the background. The service will be stopped before removal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se está ejecutando en segundo plano. El servicio se detendrá antes de eliminarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fonctionne en arrière-plan. Le service sera arrêté avant la suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è in esecuzione in background. Il servizio verrà arrestato prima della rimozione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ はバックグラウンドで実行中です。削除する前にサービスを停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 백그라운드에서 실행 중입니다. 제거하기 전에 서비스를 중지합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ działa w tle. Usługa zostanie zatrzymana przed usunięciem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está em execução em segundo plano. O serviço será interrompido antes da remoção."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ arka planda çalışıyor. Kaldırmadan önce hizmet durdurulacak."
