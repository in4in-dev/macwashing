    "Системные файлы тех же удалённых программ: службы, плагины, утилиты и следы установки." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemdateien derselben gelöschten Apps: Dienste, Plug-ins, Werkzeuge und Installationsspuren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System files of the same deleted apps: services, plug-ins, tools and installation traces."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archivos del sistema de esas mismas apps eliminadas: servicios, plug-ins, utilidades y rastros de instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
