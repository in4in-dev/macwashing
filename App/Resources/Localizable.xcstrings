        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것이 없으면 다음이 작동하지 않습니다: %@. 그래도 제거할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez tego przestaną działać: %@. Mimo to możesz je usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem ela, estas deixam de funcionar: %@. Mesmo assim, você pode removê-la."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu olmadan şunlar çalışmaz: %@. Yine de kaldırabilirsiniz."
