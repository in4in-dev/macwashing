    "Записи системных служб о работе и ошибках. macOS начнёт вести их заново." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufzeichnungen der Systemdienste über ihre Arbeit und Fehler. macOS legt von selbst neue an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What system services record about their work and errors. macOS starts new ones by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros de los servicios del sistema sobre su funcionamiento y sus errores. macOS empieza otros nuevos por sí solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que les services système notent sur leur fonctionnement et leurs erreurs. macOS en recommence de nouveaux tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrazioni dei servizi di sistema sul loro funzionamento e sugli errori. macOS ne avvia di nuove da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムサービスが動作やエラーを記録したものです。macOSが自動的に新しく記録し直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 서비스가 작동과 오류를 기록한 내용입니다. macOS가 알아서 새로 기록합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisy usług systemowych o ich pracy i błędach. macOS sam zacznie prowadzić nowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registros dos serviços do sistema sobre o funcionamento e os erros. O macOS começa novos sozinho."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem servislerinin çalışmaları ve hataları hakkındaki kayıtları. macOS yenilerini kendisi tutmaya başlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统服务关于运行和错误的记录。macOS 会自动重新开始记录。"
          }
        }
      }
    },
