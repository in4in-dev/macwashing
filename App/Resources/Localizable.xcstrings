          }
        }
      }
    },
    "Без полного доступа к диску часть связанных файлов в защищённых папках не найдена — размеры могут быть меньше настоящих." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne vollen Festplattenzugriff wurden einige zugehörige Dateien in geschützten Ordnern nicht gefunden – die Größen können zu klein sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without Full Disk Access some related files in protected folders were not found, so sizes may be smaller than they really are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin acceso total al disco no se encontraron algunos archivos relacionados en carpetas protegidas, así que los tamaños pueden ser menores que los reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans l’accès complet au disque, certains fichiers associés dans des dossiers protégés n’ont pas été trouvés : les tailles peuvent être sous-estimées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza accesso completo al disco alcuni file correlati in cartelle protette non sono stati trovati: le dimensioni possono essere inferiori a quelle reali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルディスクアクセスがないため、保護されたフォルダ内の関連ファイルの一部が見つからず、サイズが実際より小さく表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 디스크 접근 권한이 없어 보호된 폴더의 관련 파일 일부를 찾지 못해 크기가 실제보다 작게 보일 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez pełnego dostępu do dysku nie znaleziono części powiązanych plików w chronionych folderach — rozmiary mogą być mniejsze niż w rzeczywistości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem acesso total ao disco, alguns arquivos relacionados em pastas protegidas não foram encontrados, então os tamanhos podem ser menores que os reais."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam Disk Erişimi olmadığı için korumalı klasörlerdeki bazı ilgili dosyalar bulunamadı; boyutlar gerçekte olduğundan küçük görünebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有“完全磁盘访问权限”，受保护文件夹中的部分相关文件未找到，显示的大小可能小于实际。"
          }
        }
      }
    },
    "Не закрылись и не удалены: %@. Закройте их и повторите" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht beendet, nicht entfernt: %@. Beende sie und versuche es erneut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didn’t quit, not removed: %@. Quit them and try again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se cerraron y no se eliminaron: %@. Ciérralas y vuelve a intentarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non quittées, non supprimées : %@. Quittez-les et réessayez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non chiuse e non rimosse: %@. Chiudile e riprova"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了しなかったため削除していません：%@。終了してからもう一度お試しください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "종료되지 않아 제거하지 않음: %@. 종료한 후 다시 시도하세요"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zamknęły się i nie zostały usunięte: %@. Zamknij je i spróbuj ponownie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não fecharam e não foram removidos: %@. Feche-os e tente novamente"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapanmadı, kaldırılmadı: %@. Kapatıp yeniden deneyin"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未退出，未移除：%@。请退出后重试"
          }
        }
      }
    },
    "Нужен помощник" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfsprogramm nötig"
