          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルパーなしでは削除できないシステム項目：%lld。これらはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도우미 없이는 제거할 수 없는 시스템 항목: %lld. 이 항목은 건너뜁니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
