    "Их файлы сейчас заняты. Как только программа закроется, очистка продолжится сама." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Dateien werden gerade verwendet. Sobald eine App beendet ist, geht die Bereinigung von selbst weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their files are in use. As soon as an app quits, cleaning goes on by itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus archivos están en uso. En cuanto se cierre una app, la limpieza continuará sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs fichiers sont en cours d’utilisation. Dès qu’une app est quittée, le nettoyage reprend tout seul."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I loro file sono in uso. Appena un’app viene chiusa, la pulizia riprende da sola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのファイルは使用中です。アプリが終了すると、クリーンアップが自動的に続行されます。"
