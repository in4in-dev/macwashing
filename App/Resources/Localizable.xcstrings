    "Для системных агентов и служб нужен помощник: установите его в Настройках." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Systemagenten und -dienste wird das Hilfsprogramm benötigt: Installieren Sie es in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System agents and services need the helper: install it in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los agentes y servicios del sistema necesitan el asistente: instálalo en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les agents et services système nécessitent l’assistant : installez-le dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per agenti e servizi di sistema serve l’assistente: installalo nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムエージェントとサービスにはヘルパーが必要です。設定でインストールしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 에이전트와 서비스에는 도우미가 필요합니다. 설정에서 설치하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenty i usługi systemowe wymagają pomocnika: zainstaluj go w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentes e serviços do sistema precisam do auxiliar: instale-o nos Ajustes."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem ajanları ve hizmetleri için yardımcı gerekir: Ayarlar’dan yükleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统代理和服务需要助手：请在设置中安装。"
          }
        }
      }
