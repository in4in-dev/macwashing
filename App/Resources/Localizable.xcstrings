    "Находит всё, что программа разложила по Mac, даже в скрытых папках." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet alles, was eine App auf dem Mac verteilt hat, selbst in versteckten Ordnern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds everything an app has spread across your Mac, even in hidden folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra todo lo que una app ha repartido por el Mac, incluso en carpetas ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve tout ce qu’une app a dispersé sur le Mac, même dans les dossiers masqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova tutto ciò che un’app ha sparso sul Mac, anche nelle cartelle nascoste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがMacのあちこちに置いたものを、隠しフォルダの中まで見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 Mac 곳곳에 남긴 모든 것을 숨겨진 폴더까지 찾아냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znajduje wszystko, co aplikacja rozrzuciła po Macu, nawet w ukrytych folderach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra tudo o que um app espalhou pelo Mac, até em pastas ocultas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir uygulamanın Mac’e dağıttığı her şeyi, gizli klasörlerde bile bulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出 App 散落在 Mac 各处的所有内容，连隐藏文件夹也不放过。"
          }
        }
      }
    },
