        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 正在后台运行。移除前将停止该服务。"
          }
        }
      }
    },
    "Без неё перестанут работать: %@. Удалить её всё равно можно." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne sie funktionieren nicht mehr: %@. Entfernen kannst du sie trotzdem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without it these stop working: %@. You can still remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin ella dejarán de funcionar: %@. Aun así puedes eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans lui, ceux-ci ne fonctionneront plus : %@. Vous pouvez quand même le supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza di esso smetteranno di funzionare: %@. Puoi comunque rimuoverlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これがないと次が動作しなくなります: %@。それでも削除できます。"
