    "Объекты в Корзине: %lld — %@. Они будут удалены безвозвратно, это действие нельзя отменить." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte im Papierkorb: %1$lld — %2$@. Sie werden endgültig gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items in the Trash: %1$lld — %2$@. They will be deleted permanently. This can’t be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementos en la Papelera: %1$lld — %2$@. Se eliminarán de forma permanente. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éléments dans la Corbeille : %1$lld — %2$@. Ils seront supprimés définitivement. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementi nel Cestino: %1$lld — %2$@. Verranno eliminati definitivamente. L’operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱内の項目：%1$lld — %2$@。完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통의 항목: %1$lld — %2$@. 영구적으로 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiekty w Koszu: %1$lld — %2$@. Zostaną trwale usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itens no Lixo: %1$lld — %2$@. Eles serão apagados permanentemente. Esta ação não pode ser desfeita."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepeti’ndeki öğeler: %1$lld — %2$@. Kalıcı olarak silinecekler. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "废纸篓中的项目：%1$lld — %2$@。它们将被永久删除。此操作无法撤销。"
          }
        }
      }
    },
