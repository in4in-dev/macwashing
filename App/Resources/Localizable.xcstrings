    "Системные программы Apple защищены macOS и не удаляются." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System-Apps von Apple sind durch macOS geschützt und können nicht entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple system apps are protected by macOS and can’t be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las apps del sistema de Apple están protegidas por macOS y no se pueden eliminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les apps système d’Apple sont protégées par macOS et ne peuvent pas être supprimées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le app di sistema Apple sono protette da macOS e non possono essere rimosse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleのシステムアプリはmacOSによって保護されているため、削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 시스템 앱은 macOS에 의해 보호되며 제거할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemowe aplikacje Apple są chronione przez macOS i nie można ich usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os apps do sistema da Apple são protegidos pelo macOS e não podem ser removidos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple sistem uygulamaları macOS tarafından korunur ve kaldırılamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 系统 App 受 macOS 保护，无法移除。"
          }
        }
      }
    },
    "Системные файлы и данные установленных программ защищены правилами базы." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemdateien und Daten installierter Apps sind durch die Regeldatenbank geschützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System files and the data of installed apps are protected by the rule base."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos del sistema y los datos de las apps instaladas están protegidos por la base de reglas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers système et les données des apps installées sont protégés par la base de règles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file di sistema e i dati delle app installate sono protetti dalla base di regole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムファイルとインストール済みアプリのデータは、ルールベースによって保護されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 파일과 설치된 앱의 데이터는 규칙 데이터베이스로 보호됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki systemowe i dane zainstalowanych aplikacji są chronione przez reguły z bazy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os arquivos do sistema e os dados dos apps instalados são protegidos pela base de regras."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem dosyaları ve yüklü uygulamaların verileri kural veritabanı tarafından korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统文件和已安装 App 的数据受规则库保护。"
          }
        }
      }
    },
    "Системный кэш" : {
      "localizations" : {
        "de" : {
