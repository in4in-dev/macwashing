          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odwołać „%1$@” dla %2$@?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revogar “%1$@” de %2$@?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ için “%1$@” izni iptal edilsin mi?"
          }
        },
        "zh-Hans" : {
