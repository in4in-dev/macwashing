    "Это системное разрешение: без помощника macOS может отказать." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist eine Systemberechtigung: Ohne das Hilfsprogramm kann macOS die Änderung verweigern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a system permission: without the helper macOS may refuse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es un permiso del sistema: sin el asistente, macOS puede rechazar el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit d’une autorisation du système : sans l’assistant, macOS peut refuser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È un permesso di sistema: senza l’assistente macOS potrebbe rifiutare la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
