    "Системных объектов без помощника не удалить: %lld. Они будут пропущены." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemobjekte, die ohne Hilfsprogramm nicht entfernt werden können: %lld. Sie werden übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System items that can’t be removed without the helper: %lld. They will be skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementos del sistema que no se pueden eliminar sin el asistente: %lld. Se omitirán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éléments système impossibles à supprimer sans l’assistant : %lld. Ils seront ignorés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
