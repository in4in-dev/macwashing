        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该 App 会立即失去访问权限，需要时可以再次请求。"
          }
        }
      }
    },
    "Запретить доступ этой программе можно только в Системных настройках" : {
