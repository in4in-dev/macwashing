    "Журналы нужны разработчикам для диагностики ошибок. Для работы программ они не требуются." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolle helfen Entwicklern bei der Fehlersuche. Apps brauchen sie nicht, um zu funktionieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs help developers diagnose errors. Apps don’t need them to work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros ayudan a los desarrolladores a diagnosticar errores. Las apps no los necesitan para funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux aident les développeurs à diagnostiquer les erreurs. Les apps n’en ont pas besoin pour fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I log aiutano gli sviluppatori a diagnosticare gli errori. Le app non ne hanno bisogno per funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログは開発者がエラーを診断するためのものです。アプリの動作には必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그는 개발자가 오류를 진단하는 데 사용됩니다. 앱이 작동하는 데는 필요하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzienniki pomagają programistom diagnozować błędy. Aplikacje nie potrzebują ich do działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros ajudam os desenvolvedores a diagnosticar erros. Os apps não precisam deles para funcionar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlükler, geliştiricilerin hataları teşhis etmesine yardımcı olur. Uygulamaların çalışması için gerekli değildir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日志用于帮助开发者诊断错误。App 运行并不需要它们。"
          }
        }
      }
    },
    "Журналы программ" : {
