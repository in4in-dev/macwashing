          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行旧版本（%@）。请更新助手，以便完整地移除系统文件夹"
          }
        }
      }
    },
    "Очистка остановлена · освобождено %@" : {
