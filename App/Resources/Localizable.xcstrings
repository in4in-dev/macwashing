    "Разрешите MacWashing полный доступ к диску, чтобы видеть её содержимое." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib MacWashing Festplattenvollzugriff, um den Inhalt zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give MacWashing Full Disk Access to see what’s inside."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale a MacWashing acceso total al disco para ver su contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accordez l’accès complet au disque à MacWashing pour voir son contenu."
